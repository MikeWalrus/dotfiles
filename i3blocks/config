command=~/.config/i3blocks/bin/$BLOCK_NAME

[playerctl]
interval=5

[battery2]
markup=pango
interval=10

[volume-pipewire]
interval=once
signal=1
LONG_FORMAT="${SYMB}${VOL}%"
SHORT_FORMAT="${SYMB}${VOL}%"

[wifi]
interval=30

[disk]
DIR=/
interval=30

[disk]
interval=30

[free-memory]
label=Mem 
interval=5

[cpu-usage2]
markup=pango
interval=persist
#min_width=0%
REFRESH_TIME=5
LABEL=
#WARN_PERCENT=50
#CRIT_PERCENT=80
DECIMALS=0

[temperature]
label=
interval=5
T_WARN=70
T_CRIT=90
SENSOR_CHIP="coretemp-isa-0000"

[time]
command=date '+%Y-%m-%d %H:%M:%S'
interval=1

