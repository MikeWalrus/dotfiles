#! /usr/bin/bash

mode=$(makoctl mode)
pkill --signal=RTMIN+2 waybar

if [[ "${mode}" == *"dnd"* ]]; then
    notify-send --icon=call-start "Notification on"
    makoctl mode -r dnd
else
    notify-send --icon=call-stop "Notification paused"
    makoctl mode -a dnd
fi

pkill --signal=RTMIN+2 waybar
